@host = http://localhost:3000

### 1. Sin token  ->  200. Los Productos son publicos
GET {{host}}/products


### 2. Login con contrasena mala  ->  401 "Credenciales invalidas"
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "karla@itson.mx", "password": "otra" }


### 3. Login de Karla  ->  200 con el token
# @name loginKarla
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "karla@itson.mx", "password": "gimnasio2026" }

###
@tokenKarla = {{loginKarla.response.body.data.access_token}}


### 4. Lo que viaja dentro del token  ->  200
GET {{host}}/auth/yo
Authorization: Bearer {{tokenKarla}}

### 5. Obtener Clientes con Rol Client -> 403
GET {{host}}/clients
Authorization: Bearer {{tokenKarla}}

### 6. Crear una Orden -> 201
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{tokenKarla}}

{
  "idClient": 1,
  "scheduleTime": "2026-10-21T15:30:00Z",
  "notes": "Sin cebolla por favor",
  "deliveryMode": "DELIVERY",
  "fulfillmentType": "IMMEDIATE",
  "details": [
    {
      "idProduct": 1,
      "quantity": 2,
      "price": 8.50
    },
    {
      "idProduct": 3,
      "quantity": 1,
      "price": 2.00
    }
  ]
}

### 7. Crear una orden a un cliente ajeno a nosotros -> 403
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{tokenKarla}}

{
  "idClient": 2,
  "deliveryMode": "PICKUP",
  "fulfillmentType": "IMMEDIATE",
  "details": [
    {
      "idProduct": 2,
      "quantity": 1,
      "price": 3.00
    }
  ]
}

### 8. Crear orden con datos erroneos -> 400
POST {{host}}/orders
Content-Type: application/json
Authorization: Bearer {{tokenKarla}}

{
  "idClient": 1,
  "notes": "Esta orden tiene datos inválidos",
  "details": [
    {
      "idProduct": 1,
      "quantity": -5, 
      "price": 10.00
    }
  ]
}


### 9. Login de Admin  ->  200 con el token
# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{ "correo": "admin@itson.mx", "password": "gimnasio2026" }

###
@tokenAdmin = {{loginAdmin.response.body.data.access_token}}

### 10. Lo que viaja dentro del token  ->  200
GET {{host}}/auth/yo
Authorization: Bearer {{tokenAdmin}}

### 11. Obtener Clientes -> 200
GET {{host}}/clients
Authorization: Bearer {{tokenAdmin}}
